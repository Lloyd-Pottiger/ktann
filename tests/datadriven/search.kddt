# ----------------------------------------------------------------------
# Bounded search over a clustered dataset: exact hits, budget accounting,
# predicate filtering, and truncation reporting. Later sections cover ties
# and duplicates at the k boundary, empty trees and partitions, and the
# same scenario under every metric (issue #100, items A3/A5).
# ----------------------------------------------------------------------
new-index dimension=8 metric=L2 fields=bucket:i64,score:f64? tree-key-fields=0 min-entries=8 max-entries=32
----
created index "index"

load dataset=clustered:2000:8 tree=1 via=batch seed=7
----
loaded 2000 records (dataset=clustered:2000:8, seed=7)

validate
----
ok: records=2000 trees=1 partitions=1 max_level=1

# An unfiltered search with sufficient budgets is exact.
search k=5 vector=[0,0,0,0,0,0,0,0]
----
r000103: 1.3630
r000504: 1.3691
r001343: 1.3692
r001393: 1.3858
r001522: 1.3923
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=2000 exact_rerank_candidates=7
exhausted: rabitq_overlap_truncated

# The nullable f64 field filters exactly: score <= 10.5 keeps ordinals 0..=9
# and 3 (NULL) never qualifies under SQL three-valued logic.
search k=20 vector=[0,0,0,0,0,0,0,0] where=1:le:10.5
----
r000009: 1.4586
r000008: 2.1333
r000006: 2.7269
r000005: 2.9405
r000002: 3.2921
r000004: 3.4862
r000000: 3.8138
r000007: 3.8434
r000001: 3.9469
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=2000 exact_rerank_candidates=9

# SQL UNKNOWN never qualifies; only IS NULL returns the NULL-score rows.
search k=20 vector=[0,0,0,0,0,0,0,0] where=1:isnull
----
r001522: 1.3923
r001564: 1.4358
r000262: 1.4883
r001893: 1.5312
r000710: 1.5348
r000969: 1.5485
r001207: 1.5892
r001851: 1.5930
r001795: 1.6036
r001270: 1.6153
r001172: 1.6186
r000073: 1.6289
r000605: 1.6369
r000192: 1.6462
r000682: 1.6558
r001081: 1.6870
r000479: 1.7040
r000395: 1.7145
r001340: 1.7207
r000787: 1.7227
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=2000 exact_rerank_candidates=22
exhausted: rabitq_overlap_truncated

# IN on the Tree Key field plus NOT NULL on the nullable score.
search k=10 vector=[0,0,0,0,0,0,0,0] where=0:in:1 where=1:notnull
----
r000103: 1.3630
r000504: 1.3691
r001343: 1.3692
r001393: 1.3858
r001085: 1.4060
r000523: 1.4072
r000904: 1.4172
r000356: 1.4176
r001254: 1.4284
r001364: 1.4314
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=2000 exact_rerank_candidates=16
exhausted: rabitq_overlap_truncated

# Not-equal excludes exactly the matching score.
search k=5 vector=[0,0,0,0,0,0,0,0] where=1:ne:5.5 where=1:le:10.5
----
r000009: 1.4586
r000008: 2.1333
r000006: 2.7269
r000002: 3.2921
r000004: 3.4862
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=2000 exact_rerank_candidates=5

# A depleted Leaf Entry budget truncates and says so.
search k=5 vector=[0,0,0,0,0,0,0,0] visited-leaf-entries=50
----
r000009: 1.4586
r000016: 1.7387
r000018: 1.8086
r000028: 1.8168
r000008: 2.1333
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=50 exact_rerank_candidates=5
exhausted: visited_leaf_entries

# ----------------------------------------------------------------------
# A5: an empty tree reports zero hits with budget usage still accounted.
# ----------------------------------------------------------------------
new-index dimension=2 metric=L2 fields=bucket:i64 tree-key-fields=0 min-entries=2 max-entries=4
----
created index "index"

search k=3 vector=[0,0]
----
usage: scanned_tree_keys=0 visited_partitions=0 visited_leaf_entries=0 exact_rerank_candidates=0

# ----------------------------------------------------------------------
# A3: ties and duplicates at the k boundary. Duplicate vectors tie on exact
# distance and resolve by unsigned lexicographic Record ID bytes; the result
# is truncated to exactly k — there is no MaxExtraResults-style spillover.
# ----------------------------------------------------------------------
insert tree=1
a: [0,0]
b: [1,0]
c: [1,0]
d: [1,0]
e: [2,0]
f: [3,0]
----
a: ok
b: ok
c: ok
d: ok
e: ok
f: ok

# A three-way tie at the boundary: k=2 takes the smallest tied Record ID,
# k=3 and k=4 walk the tie in Record ID order, never more than k hits.
search k=2 vector=[0,0]
----
a: 0.0000
b: 1.0000
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=6 exact_rerank_candidates=4

search k=3 vector=[0,0]
----
a: 0.0000
b: 1.0000
c: 1.0000
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=6 exact_rerank_candidates=4

search k=4 vector=[0,0]
----
a: 0.0000
b: 1.0000
c: 1.0000
d: 1.0000
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=6 exact_rerank_candidates=4

# The tie order is global: it is identical after the root split scatters
# the duplicates across two leaves.
split tree=1 partition=1
----
pk=1: split into left=2 right=3

search k=4 vector=[0,0]
----
a: 0.0000
b: 1.0000
c: 1.0000
d: 1.0000
usage: scanned_tree_keys=1 visited_partitions=3 visited_leaf_entries=6 exact_rerank_candidates=4

validate
----
ok: records=6 trees=1 partitions=3 max_level=2

# A5: deleting everything leaves an empty internal root with empty leaf
# partitions; search still reports its (zero) budget usage.
delete
a
b
c
d
e
f
----
a: true
b: true
c: true
d: true
e: true
f: true

format-tree
----
tree 0: root pk=1
  pk=1 level=2 state=Ready count=2
    pk=2 level=1 state=Ready count=0
    pk=3 level=1 state=Ready count=0

search k=3 vector=[0,0]
----
usage: scanned_tree_keys=1 visited_partitions=3 visited_leaf_entries=0 exact_rerank_candidates=0

validate
----
ok: records=0 trees=1 partitions=3 max_level=2

# ----------------------------------------------------------------------
# A5: the same scenario under Cosine and InnerProduct — one insert set, one
# split, and identical queries across both metrics, recording each metric's
# exact distance semantics over the same topology shape. The zero vector has
# no direction and is rejected under Cosine; InnerProduct accepts it, so the
# shared set below is non-zero (and still carries a three-way duplicate).
# ----------------------------------------------------------------------
new-index dimension=2 metric=Cosine fields=bucket:i64 tree-key-fields=0 min-entries=2 max-entries=4
----
created index "index"

insert tree=1
zero: [0,0]
----
zero: error InvalidArgument

insert tree=1
a: [1,1]
b: [1,0]
c: [1,0]
d: [1,0]
e: [2,1]
f: [3,1]
----
a: ok
b: ok
c: ok
d: ok
e: ok
f: ok

search k=4 vector=[1,0]
----
b: 0.0000
c: 0.0000
d: 0.0000
f: 0.0513
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=6 exact_rerank_candidates=4

split tree=1 partition=1
----
pk=1: split into left=2 right=3

search k=4 vector=[1,0]
----
b: 0.0000
c: 0.0000
d: 0.0000
f: 0.0513
usage: scanned_tree_keys=1 visited_partitions=3 visited_leaf_entries=6 exact_rerank_candidates=4

search k=4 vector=[1,0] where=0:eq:1
----
b: 0.0000
c: 0.0000
d: 0.0000
f: 0.0513
usage: scanned_tree_keys=1 visited_partitions=3 visited_leaf_entries=6 exact_rerank_candidates=4

validate
----
ok: records=6 trees=1 partitions=3 max_level=2

new-index dimension=2 metric=InnerProduct fields=bucket:i64 tree-key-fields=0 min-entries=2 max-entries=4
----
created index "index"

insert tree=1
a: [1,1]
b: [1,0]
c: [1,0]
d: [1,0]
e: [2,1]
f: [3,1]
----
a: ok
b: ok
c: ok
d: ok
e: ok
f: ok

search k=4 vector=[1,0]
----
f: -3.0000
e: -2.0000
a: -1.0000
b: -1.0000
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=6 exact_rerank_candidates=6

split tree=1 partition=1
----
pk=1: split into left=2 right=3

search k=4 vector=[1,0]
----
f: -3.0000
e: -2.0000
a: -1.0000
b: -1.0000
usage: scanned_tree_keys=1 visited_partitions=3 visited_leaf_entries=6 exact_rerank_candidates=6

search k=4 vector=[1,0] where=0:eq:1
----
f: -3.0000
e: -2.0000
a: -1.0000
b: -1.0000
usage: scanned_tree_keys=1 visited_partitions=3 visited_leaf_entries=6 exact_rerank_candidates=6

validate
----
ok: records=6 trees=1 partitions=3 max_level=2

