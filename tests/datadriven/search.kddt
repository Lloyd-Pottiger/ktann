usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=2000 exact_rerank_candidates=7

# The nullable f64 field filters exactly: score <= 10.5 keeps ordinals 0..=9
# and 3 (NULL) never qualifies under SQL three-valued logic.
search k=20 vector=[0,0,0,0,0,0,0,0] where=1:le:10.5
