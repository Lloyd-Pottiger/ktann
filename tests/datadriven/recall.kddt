# ----------------------------------------------------------------------
# Recall quality against a brute-force oracle on a settled, multi-level tree.
# Queries are generated independently from the loaded records so this measures
# routing quality rather than exact self-query matches. The beam sweep keeps
# the traversal trade-off observable at a dataset size that actually creates
# multiple searchable levels.
# ----------------------------------------------------------------------
# Cosine routing must be exercised on a settled, multi-level tree.
new-index dimension=16 metric=Cosine fields=bucket:i64 tree-key-fields=0 min-entries=8 max-entries=16
