# ----------------------------------------------------------------------
# Recall against the brute-force oracle and search-quality beam sweeps.
#
# Flat leaves with sufficient budgets are exact scans: recall must be 100%
# for every metric and distribution; tight budgets truncate and report it.
# The settled-tree suites sweep leaf beam width over the same queries,
# recording hit quality and visited-partition cost as two-line regression
# goldens (issue #100, items A1/B1; merged from the former beam.kddt).
# ----------------------------------------------------------------------
new-index dimension=8 metric=L2 fields=bucket:i64 tree-key-fields=0
----
created index "index"

load dataset=uniform:5000 tree=1 via=import seed=11
----
loaded 5000 records (dataset=uniform:5000, seed=11)

recall k=10 samples=20
----
recall@10: 100.00% (samples=20, truncated=20)
mean usage: visited_partitions=1 visited_leaf_entries=5000 exact_rerank_candidates=11

recall k=10 samples=20 visited-leaf-entries=64
----
recall@10: 1.00% (samples=20, truncated=20)
mean usage: visited_partitions=1 visited_leaf_entries=64 exact_rerank_candidates=10

# Cross-distribution queries: clustered queries against uniform data.
recall k=10 samples=20 query=clustered:20:6 query-seed=99
----
recall@10: 100.00% (samples=20, truncated=20)
mean usage: visited_partitions=1 visited_leaf_entries=5000 exact_rerank_candidates=12

# Cosine over clustered data. The k-derived exact-rerank cap is smaller than
# the 3000-entry leaf, so `truncated` reports the RaBitQ candidate
# window, not a recall failure: recall stays exact when the truth survives
# the window.
new-index dimension=16 metric=Cosine fields=bucket:i64 tree-key-fields=0
----
created index "index"

load dataset=clustered:3000:6 tree=1 seed=12
----
loaded 3000 records (dataset=clustered:3000:6, seed=12)

recall k=10 samples=20
----
recall@10: 100.00% (samples=20, truncated=20)
mean usage: visited_partitions=1 visited_leaf_entries=3000 exact_rerank_candidates=64

# Inner product over skewed data; same truncation semantics as above.
new-index dimension=16 metric=InnerProduct fields=bucket:i64 tree-key-fields=0
----
created index "index"

load dataset=skewed:3000 tree=1 seed=13
----
loaded 3000 records (dataset=skewed:3000, seed=13)

recall k=10 samples=20
----
recall@10: 100.00% (samples=20, truncated=20)
mean usage: visited_partitions=1 visited_leaf_entries=3000 exact_rerank_candidates=59

# --- Beam-width sweep on a settled synthetic tree ---
new-index dimension=8 metric=L2 fields=bucket:i64 tree-key-fields=0 min-entries=8 max-entries=32
