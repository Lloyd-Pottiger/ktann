# --- Real datasets at 1k: flat exactness, then a fully settled tree ---
# The 1k prefix of the checked-in fixtures keeps a full settle (split-all)
# cheap enough for the debug corpus; settling the full 10k fixtures stays
# out of scope (#98, issue #100 item B3). The flat leaf is an exact scan;
# the settled tree sweeps beam width on real distances, and an exact filter
# prunes on the settled tree.
new-index name=sift1k dimension=128 metric=L2 fields=bucket:i64,label:i64 tree-key-fields=0 min-entries=8 max-entries=32
----
created index "sift1k"

load dataset=file:siftsmall_base.fvecs:1000 tree=1 via=batch batch=100
----
loaded 1000 records (dataset=file:siftsmall_base.fvecs:1000, seed=42)

validate
----
ok: records=1000 trees=1 partitions=1 max_level=1

# The flat 1k leaf is an exact scan: 100% recall against the oracle.
recall k=10 samples=10 query=file:siftsmall_query.fvecs
----
recall@10: 100.00% (samples=10, truncated=10)
mean usage: visited_partitions=1 visited_leaf_entries=1000 exact_rerank_candidates=19

