# ----------------------------------------------------------------------
# Beam-width and rerank-budget sweeps (issue #100, items A1/A2): the same
# queries over the same settled tree at growing leaf beam widths, recording
# hit quality and visited-partition cost as a two-line regression golden,
# and the exact-rerank candidate budget swept around the k multiple that
# proves the rerank stage's value. Estimate distances deliberately never
# leave the engine (design search.md section 7), so the rerank stage is
# ablated through its candidate budget, not through a skip switch.
# ----------------------------------------------------------------------
new-index dimension=8 metric=L2 fields=bucket:i64 tree-key-fields=0 min-entries=8 max-entries=32
----
created index "index"

load dataset=clustered:2000:8 tree=1 via=batch seed=7
