# ----------------------------------------------------------------------
# Tree Fan-out: records spread over four Tree Keys, enumerated or
# predicate-selected, with the scanned Tree Key budget accounted.
# ----------------------------------------------------------------------
new-index dimension=4 metric=L2 fields=bucket:i64 tree-key-fields=0
----
created index "index"

load dataset=clustered:2000:4 tree=1..4 seed=21
----
loaded 2000 records (dataset=clustered:2000:4, seed=21)

validate
----
ok: records=2000 trees=4 partitions=4 max_level=1

format-tree
----
tree 0: root pk=1
  pk=1 level=1 state=Ready count=500
tree 1: root pk=1
  pk=1 level=1 state=Ready count=500
tree 2: root pk=1
  pk=1 level=1 state=Ready count=500
tree 3: root pk=1
  pk=1 level=1 state=Ready count=500

# Without a predicate every tree is enumerated.
search k=5 vector=[0,0,0,0]
----
r000895: 0.9240
r001641: 0.9636
r000662: 1.0141
r001923: 1.0538
r000284: 1.0555
usage: scanned_tree_keys=4 visited_partitions=4 visited_leaf_entries=2000 exact_rerank_candidates=5

# A predicate on the Tree Key field selects exactly one tree.
search k=5 vector=[0,0,0,0] where=0:eq:2
----
r001641: 0.9636
r000537: 1.0815
r000149: 1.0835
r001973: 1.1712
r000233: 1.1783
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=500 exact_rerank_candidates=7

# A scanned Tree Key budget below the fan-out truncates enumeration.
search k=5 vector=[0,0,0,0] scanned-tree-keys=2
----
r001641: 0.9636
r000284: 1.0555
r000537: 1.0815
r000149: 1.0835
r000892: 1.1363
usage: scanned_tree_keys=2 visited_partitions=2 visited_leaf_entries=1000 exact_rerank_candidates=5
exhausted: scanned_tree_keys

# --- Cross-tree isolation (issue #100, item D2) ---
# Churn on trees 2..4 — splits, merges, inserts, upserts, deletes — must
# leave tree 1 byte-identical, in structure and in content. The two
# format-tree snapshots and the two filtered searches below are the
# before/after pair.
new-index dimension=4 metric=L2 fields=bucket:i64 tree-key-fields=0 min-entries=4 max-entries=8
----
created index "index"

load dataset=clustered:40:4 tree=1..4 seed=3
----
loaded 40 records (dataset=clustered:40:4, seed=3)

format-tree tree=1 entries
----
tree 0: root pk=1
  pk=1 level=1 state=Ready count=10
    r000000
    r000004
    r000008
    r000012
    r000016
    r000020
    r000024
    r000028
    r000032
    r000036

search k=3 vector=[0,0,0,0] where=0:eq:1
----
r000028: 1.5494
r000016: 1.9021
r000020: 1.9425
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=10 exact_rerank_candidates=4

split-all tree=2
----
pk=1: split into left=2 right=3
settled

split-all tree=4
----
pk=1: split into left=2 right=3
settled

insert tree=3
x1: [9,9,9,9]
x2: [8,9,8,9]
----
x1: ok
x2: ok

upsert tree=4
r000003: [7,7,7,7]
x3: [6,6,6,6]
----
r000003: replaced
x3: created

# Deletes by Record ID target tree 2 members only (ordinal % 4 == 1).
delete
r000001
r000005
r000009
----
r000001: true
r000005: true
r000009: true

# Three deletes force at least one balanced target below the minimum.
merge-step tree=2
----
pk=3: began

format-tree tree=1 entries
----
tree 0: root pk=1
  pk=1 level=1 state=Ready count=10
    r000000
    r000004
    r000008
    r000012
    r000016
    r000020
    r000024
    r000028
    r000032
    r000036

search k=3 vector=[0,0,0,0] where=0:eq:1
----
r000028: 1.5494
r000016: 1.9021
r000020: 1.9425
usage: scanned_tree_keys=1 visited_partitions=1 visited_leaf_entries=10 exact_rerank_candidates=4

validate
----
ok: records=40 trees=4 partitions=8 max_level=2

