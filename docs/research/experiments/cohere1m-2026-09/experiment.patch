+/// Hashes logical KV contents, independent of compaction and physical files.
+#[cfg(feature = "rocksdb")]
+fn diagnostic_database_hash(database: &rocksdb::OptimisticTransactionDB) -> Result<String, String> {
+    use sha2::{Digest, Sha256};
+    let mut hash = Sha256::new();
+    for row in database.snapshot().iterator(rocksdb::IteratorMode::Start) {
+        let (key, value) = row.map_err(|e| e.to_string())?;
+        hash.update((key.len() as u64).to_le_bytes());
+        hash.update(&key);
+        hash.update((value.len() as u64).to_le_bytes());
+        hash.update(&value);
+    }
+    Ok(format!("{:x}", hash.finalize()))
+}
