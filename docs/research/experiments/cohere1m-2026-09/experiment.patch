@@ -0,0 +1,115 @@
+//! Experiment-only recall attribution; never included in the production patch.
+//!
+//! The isolated harness admits exactly one search at a time. A process-local
+//! collector follows that request across Runtime-spawned tasks. Only ground
+//! truth IDs are retained, and no diagnostic observation influences selection.
+
+use std::collections::BTreeSet;
+use std::sync::Mutex;
+
+use crate::api::SearchOutcome;
+use bytes::Bytes;
+
+/// Successively smaller candidate sets in the existing search pipeline.
+#[derive(Clone, Copy)]
+pub enum Stage {
+    /// Entries funded by the traversal budget before local selection.
+    Visited = 0,
+    /// Entries surviving the local conservative interval predicate.
+    LocalEligible = 1,
+    /// Entries surviving the local overlap cap.
+    LocalRetained = 2,
+    /// Entries surviving the global conservative interval predicate.
+    GlobalEligible = 3,
+    /// Entries admitted for exact reranking after the global cap.
+    GlobalRetained = 4,
+}
+
+struct Trace {
+    truth: BTreeSet<Bytes>,
+    hits: [BTreeSet<Bytes>; 5],
+    counts: [usize; 5],
+}
+
+static ACTIVE: Mutex<Option<Trace>> = Mutex::new(None);
+
+/// Counts at successive sets, ending in exact output hits.
+#[derive(Debug)]
+pub struct Observation {
+    /// The complete reference top-k denominator.
+    pub truth: usize,
+    /// Ground truth hits at visited/local-eligible/local-retained/global-eligible/
+    /// global-retained/final-output stages, respectively.
+    pub hits: [usize; 6],
+    /// Total IDs at those same stages.
+    pub counts: [usize; 6],
+}
+
+/// Begins one isolated, unfiltered request with distinct reference IDs.
+pub fn begin(truth: Vec<Bytes>) {
+    let mut active = ACTIVE.lock().unwrap();
+    assert!(active.is_none(), "diagnostic searches must be serial");
+    let count = truth.len();
+    let truth: BTreeSet<_> = truth.into_iter().collect();
+    assert_eq!(truth.len(), count);
+    assert!(count > 0);
+    *active = Some(Trace {
+        truth,
+        hits: std::array::from_fn(|_| BTreeSet::new()),
+        counts: [0; 5],
+    });
+}
+
+/// Observes IDs without changing their order, distance, or ownership.
+pub fn record<'a>(stage: Stage, ids: impl IntoIterator<Item = &'a Bytes>) {
+    let mut active = ACTIVE.lock().unwrap();
+    let Some(trace) = active.as_mut() else { return };
+    let stage = stage as usize;
+    for id in ids {
+        trace.counts[stage] += 1;
+        if trace.truth.contains(id) {
+            assert!(
+                trace.hits[stage].insert(id.clone()),
+                "duplicate truth membership"
+            );
+        }
+    }
+}
+
+/// Closes the request, proving that attribution stages are nested and cover
+/// the traversal/rerank work reported by the normal Search Outcome.
+pub fn finish(outcome: &SearchOutcome) -> Observation {
+    let trace = ACTIVE.lock().unwrap().take().expect("active diagnostic");
+    for pair in trace.hits.windows(2) {
+        assert!(pair[1].is_subset(&pair[0]), "non-nested attribution stages");
+    }
+    let final_hits: BTreeSet<_> = outcome
+        .hits
+        .iter()
+        .map(|hit| hit.id().clone())
+        .filter(|id| trace.truth.contains(id))
+        .collect();
+    assert!(final_hits.is_subset(&trace.hits[4]));
+    assert_eq!(trace.counts[0], outcome.usage.visited_leaf_entries as usize);
+    assert_eq!(
+        trace.counts[4],
+        outcome.usage.exact_rerank_candidates as usize
+    );
+    Observation {
+        truth: trace.truth.len(),
+        hits: std::array::from_fn(|stage| {
+            if stage == 5 {
+                final_hits.len()
+            } else {
+                trace.hits[stage].len()
+            }
+        }),
+        counts: std::array::from_fn(|stage| {
+            if stage == 5 {
+                outcome.hits.len()
+            } else {
+                trace.counts[stage]
+            }
+        }),
+    }
+}
